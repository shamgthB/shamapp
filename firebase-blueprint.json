{
  "entities": {
    "Username": {
      "title": "Username",
      "description": "Unique username registry mapped to user ID",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Lowercased unique username (3-30 alphanumeric and underscore characters)"
        },
        "userId": {
          "type": "string",
          "description": "UID of the registered owner"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when username was registered; client submits FieldValue.serverTimestamp()"
        }
      },
      "required": ["username", "userId", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile details for a registered user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique Firebase Auth user ID"
        },
        "username": {
          "type": "string",
          "description": "Unique username handle (lowercased)"
        },
        "displayName": {
          "type": "string",
          "description": "User visible display name"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "photoUrl": {
          "type": "string",
          "description": "Optional profile avatar URL or base64 data URI"
        },
        "status": {
          "type": "string",
          "description": "Presence status e.g. Online, Away, Busy, Offline"
        },
        "about": {
          "type": "string",
          "description": "Short bio or status message"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account registration timestamp; client submits FieldValue.serverTimestamp()"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last profile update timestamp; client submits FieldValue.serverTimestamp()"
        }
      },
      "required": ["userId", "displayName", "email", "createdAt"]
    },
    "ConnectionRequest": {
      "title": "ConnectionRequest",
      "description": "Connection or chat request between two users searched by username",
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "description": "Unique request identifier"
        },
        "fromUserId": {
          "type": "string",
          "description": "Sender user ID"
        },
        "fromUserName": {
          "type": "string",
          "description": "Sender display name"
        },
        "fromUserPhotoUrl": {
          "type": "string",
          "description": "Sender profile photo URL"
        },
        "toUserId": {
          "type": "string",
          "description": "Recipient user ID"
        },
        "toUserName": {
          "type": "string",
          "description": "Recipient display name"
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "ACCEPTED", "DECLINED"],
          "description": "Request status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp; client submits FieldValue.serverTimestamp()"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp; client submits FieldValue.serverTimestamp()"
        }
      },
      "required": ["requestId", "fromUserId", "fromUserName", "toUserId", "toUserName", "status", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct private 1-on-1 message thread strictly between two users",
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "description": "Unique thread ID (deterministic conv_uid1_uid2)"
        },
        "participantUids": {
          "type": "array",
          "description": "List containing exactly the two participant UIDs"
        },
        "lastMessage": {
          "type": "string",
          "description": "Snippet of the most recent message"
        },
        "lastMessageSenderId": {
          "type": "string",
          "description": "UID of author who sent last message"
        },
        "lastMessageAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last message"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Conversation start timestamp; client submits FieldValue.serverTimestamp()"
        }
      },
      "required": ["conversationId", "participantUids", "createdAt"]
    },
    "ConversationMessage": {
      "title": "ConversationMessage",
      "description": "Private direct message in a conversation",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "description": "Unique message ID"
        },
        "conversationId": {
          "type": "string",
          "description": "Parent conversation ID"
        },
        "senderId": {
          "type": "string",
          "description": "Author UID matching request.auth.uid"
        },
        "senderName": {
          "type": "string",
          "description": "Author display name"
        },
        "text": {
          "type": "string",
          "description": "Message body"
        },
        "participantUids": {
          "type": "array",
          "description": "Denormalized copy of the 2 participants for flat rule checks"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Message timestamp; client submits FieldValue.serverTimestamp()"
        }
      },
      "required": ["messageId", "conversationId", "senderId", "senderName", "text", "participantUids", "createdAt"]
    }
  },
  "firestore": {
    "/usernames/{username}": {
      "schema": "Username",
      "description": "Global unique username registry"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile directory (get by ID only; listing forbidden)"
    },
    "/connection_requests/{requestId}": {
      "schema": "ConnectionRequest",
      "description": "Friend and connection requests"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Direct message threads between two participants"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "ConversationMessage",
      "description": "Messages in direct message thread"
    }
  }
}
