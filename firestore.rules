rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidUsername(uname) {
      return uname is string && uname.size() >= 3 && uname.size() <= 30 && uname.matches('^[a-z0-9_]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             (!('username' in data) || data.username == null || (data.username is string && isValidUsername(data.username))) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 100 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 350000)) &&
             (!('status' in data) || data.status == null || (data.status is string && data.status.size() <= 50)) &&
             (!('about' in data) || data.about == null || (data.about is string && data.about.size() <= 500));
    }

    function isValidConnectionRequest(data) {
      return data.requestId is string && isValidId(data.requestId) &&
             data.fromUserId is string && data.fromUserId.size() > 0 && data.fromUserId.size() <= 128 &&
             data.fromUserName is string && data.fromUserName.size() >= 1 && data.fromUserName.size() <= 60 &&
             (!('fromUserPhotoUrl' in data) || data.fromUserPhotoUrl == null || (data.fromUserPhotoUrl is string && data.fromUserPhotoUrl.size() <= 350000)) &&
             data.toUserId is string && data.toUserId.size() > 0 && data.toUserId.size() <= 128 &&
             data.toUserName is string && data.toUserName.size() >= 1 && data.toUserName.size() <= 60 &&
             data.status in ['PENDING', 'ACCEPTED', 'DECLINED'] &&
             data.fromUserId != data.toUserId;
    }

    function isValidConversation(data) {
      return data.conversationId is string && isValidId(data.conversationId) &&
             data.participantUids is list && data.participantUids.size() == 2 &&
             (data.participantUids.size() == 0 || data.participantUids[0] is string) &&
             (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 500)) &&
             (!('lastMessageSenderId' in data) || (data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128)) &&
             (!('lastMessageAt' in data) || (data.lastMessageAt is timestamp && data.lastMessageAt <= request.time));
    }

    function isValidConversationMessage(data) {
      return data.messageId is string && isValidId(data.messageId) &&
             data.conversationId is string && isValidId(data.conversationId) &&
             data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
             data.participantUids is list && data.participantUids.size() == 2 &&
             (data.participantUids.size() == 0 || data.participantUids[0] is string);
    }

    // --- UNIQUE USERNAMES REGISTRY ---
    match /usernames/{username} {
      // Any client can check if a specific username is taken (allow get by ID)
      allow get: if isValidUsername(username);
      // Deny listing all usernames to prevent scraping user directories
      allow list: if false;

      // Only signed-in user can register their own unique username
      allow create: if isSignedIn() &&
                       isValidUsername(username) &&
                       incoming().username == username &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().keys().hasAll(['username', 'userId', 'createdAt']) &&
                       incoming().keys().hasOnly(['username', 'userId', 'createdAt']);

      // Username registration is immutable
      allow update: if false;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // --- USERS DIRECTORY (Strict Privacy) ---
    match /users/{userId} {
      // Individual user lookup by ID is permitted
      allow get: if isSignedIn() && isValidId(userId);
      // STRICT PRIVACY: Listing or dumping all users is completely forbidden
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'username', 'displayName', 'email', 'photoUrl', 'status', 'about', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'photoUrl', 'status', 'about', 'updatedAt']) &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                       isValidUserProfile(incoming());

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // --- CONNECTION REQUESTS ---
    match /connection_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) &&
                    (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(requestId) &&
                       incoming().requestId == requestId &&
                       incoming().fromUserId == request.auth.uid &&
                       incoming().keys().hasAll(['requestId', 'fromUserId', 'fromUserName', 'toUserId', 'toUserName', 'status', 'createdAt']) &&
                       incoming().keys().hasOnly(['requestId', 'fromUserId', 'fromUserName', 'fromUserPhotoUrl', 'toUserId', 'toUserName', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().status == 'PENDING' &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidConnectionRequest(incoming());

      allow update: if isSignedIn() &&
                       isValidId(requestId) &&
                       (existing().toUserId == request.auth.uid || existing().fromUserId == request.auth.uid) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                       incoming().status in ['ACCEPTED', 'DECLINED'] &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time));

      allow delete: if isSignedIn() &&
                       isValidId(requestId) &&
                       (existing().fromUserId == request.auth.uid || existing().toUserId == request.auth.uid);
    }

    // --- DIRECT 1-ON-1 CONVERSATIONS (Total Chat Privacy) ---
    match /conversations/{conversationId} {
      allow get: if isSignedIn() &&
                    isValidId(conversationId) &&
                    (!exists(/databases/$(database)/documents/conversations/$(conversationId)) || request.auth.uid in resource.data.participantUids);

      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(conversationId) &&
                       incoming().conversationId == conversationId &&
                       request.auth.uid in incoming().participantUids &&
                       incoming().participantUids.size() == 2 &&
                       incoming().keys().hasAll(['conversationId', 'participantUids', 'createdAt']) &&
                       incoming().keys().hasOnly(['conversationId', 'participantUids', 'lastMessage', 'lastMessageSenderId', 'lastMessageAt', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidConversation(incoming());

      allow update: if isSignedIn() &&
                       isValidId(conversationId) &&
                       request.auth.uid in resource.data.participantUids &&
                       request.auth.uid in incoming().participantUids &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageAt']) &&
                       (!('lastMessageAt' in incoming()) || (incoming().lastMessageAt is timestamp && incoming().lastMessageAt <= request.time));

      allow delete: if false;

      // Subcollection: messages inside conversation
      match /messages/{messageId} {
        allow get: if isSignedIn() &&
                      isValidId(conversationId) &&
                      isValidId(messageId) &&
                      exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
                      request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;

        allow list: if isSignedIn() &&
                       isValidId(conversationId) &&
                       exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
                       request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;

        allow create: if isSignedIn() &&
                         isValidId(conversationId) &&
                         isValidId(messageId) &&
                         incoming().messageId == messageId &&
                         incoming().conversationId == conversationId &&
                         incoming().senderId == request.auth.uid &&
                         request.auth.uid in incoming().participantUids &&
                         exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids &&
                         incoming().keys().hasAll(['messageId', 'conversationId', 'senderId', 'senderName', 'text', 'participantUids', 'createdAt']) &&
                         incoming().keys().hasOnly(['messageId', 'conversationId', 'senderId', 'senderName', 'senderPhotoUrl', 'text', 'participantUids', 'createdAt']) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidConversationMessage(incoming());

        allow update, delete: if false;
      }
    }
  }
}
